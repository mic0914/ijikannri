
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The default target is local development. Remote deploys must name an environment.
  "name": "ijikannri-access-development",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ijikannri-access-development",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "WORKER_ENV": "development",
    "PUBLIC_ORIGIN": "http://127.0.0.1:8787"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "ijikannri-access-staging",
      "vars": {
        "WORKER_ENV": "staging",
        "PUBLIC_ORIGIN": "https://ijikannri-access-staging.mic0914.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ijikannri-access-staging",
          "migrations_dir": "./migrations"
        }
      ]
    },
    "production": {
      "name": "ijikannri-access",
      "vars": {
        "WORKER_ENV": "production",
        "PUBLIC_ORIGIN": "https://ijikannri-access.mic0914.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ijikannri-access-log",
          "database_id": "SET_PRODUCTION_D1_DATABASE_ID_BEFORE_DEPLOY",
          "migrations_dir": "./migrations"
        }
      ]
    }
  }
}
